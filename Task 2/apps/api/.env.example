# ---------- Database (Supabase or Neon) ----------
# Pooled connection string used by the running app
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/modeza_dev"
# Direct (non-pooled) connection string used by `prisma migrate`
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/modeza_dev"

# ---------- App ----------
NODE_ENV=development
PORT=4000
# Public URL of this API (used to build the Google OAuth callback)
API_URL=http://localhost:4000
# Public URL of the storefront (CORS origin + email links + OAuth redirect)
WEB_URL=http://localhost:3000
# Long random strings: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
COOKIE_DOMAIN=

# ---------- Google OAuth (Google Cloud Console) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Mailgun ----------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Use https://api.eu.mailgun.net for EU-region domains
MAILGUN_API_BASE=https://api.mailgun.net
MAIL_FROM="Modeza <no-reply@your-mailgun-domain>"

# ---------- Paystack ----------
PAYSTACK_SECRET_KEY=

# First admin account created by the seed script
ADMIN_EMAIL=admin@modeza.test
ADMIN_PASSWORD=ChangeMe123!
