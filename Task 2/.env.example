# Overview of every environment variable. Copy the relevant part to:
#   apps/api/.env          (backend)   - see apps/api/.env.example
#   apps/web/.env.local    (frontend)  - see apps/web/.env.example
# Never commit real values. Never prefix secrets with NEXT_PUBLIC_.

# ===== apps/web (Vercel) =====
# URL of the deployed NestJS API. Next.js proxies /api/* to it (keeps cookies first-party).
API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== apps/api (Render / Railway) =====
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/modeza_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:54329/modeza_dev
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net
MAIL_FROM="Modeza <no-reply@mg.example.com>"
PAYSTACK_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
